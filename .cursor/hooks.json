{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/jev_policy.py",
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/jev_policy.py",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/jev_verify.py",
        "timeout": 30,
        "loop_limit": 3
      },
      {
        "command": ".cursor/hooks/jev_review.py",
        "timeout": 30,
        "loop_limit": 3
      }
    ]
  }
}
