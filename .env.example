# Copy to .env or export directly. Never commit a real key.
# Either key works. TYPESAFE_API_KEY wins when both are set.
TYPESAFE_API_KEY=ts-replace-with-real-key
# OPENROUTER_API_KEY=sk-or-replace-with-real-key
# Optional overrides
# TYPESAFE_MODEL=jev-latest            # or typesafe/jev-1.13 on OpenRouter
# TYPESAFE_ENDPOINT=https://api.typesafe.ai
