# Copy to .env or export directly. Never commit a real key.
# Either key works. TYPESAFE_API_KEY wins when both are set.
# TYPESAFE_API_KEY=ts-replace-with-real-key
# OPENROUTER_API_KEY=sk-or-replace-with-real-key

# Without JEV_PROVIDER the provider is auto-detected from which of the two keys
# above is set. JEV_PROVIDER (typesafe, openrouter or nace) names it instead. For
# TypeSafe and OpenRouter the same MODEL/ENDPOINT vars override whichever of the
# two is active. Nace is never auto-detected and ignores them (see the end).

# --- TypeSafe direct (when TYPESAFE_API_KEY is set) ---
# POST {endpoint}/v1/systemone with {state, questions, model}
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_ENDPOINT=https://api.typesafe.ai

# --- OpenRouter (when only OPENROUTER_API_KEY is set) ---
# POST {endpoint}/api/alpha/decisions, same {state, questions, model} shape,
# plus usage.cost per call. Model pinned; use ~typesafe/jev-latest to track releases.
# TYPESAFE_MODEL=typesafe/jev-1.13
# TYPESAFE_ENDPOINT=https://openrouter.ai

# --- Nace (explicit: JEV_PROVIDER=nace, or provider "nace" in the OpenCode plugin options) ---
# A NACE_API_KEY alone does not select it. While it is selected the TYPESAFE_* and
# OPENROUTER_* variables above and the plugin's generic apiKey, endpoint and model
# options are ignored.
# POST {base}/systemone with {state, questions, model} and X-Nace-Client attribution.
# JEV_PROVIDER=nace
# NACE_API_KEY=nace_sk_replace-with-real-key
# Ids on the public model list https://console.nace.ai/models (on 2026-11-11: drex-v2.0, drex-max-v1.1, drex-max-finance)
# NACE_MODEL=drex-max-v1.1
# The URL must use https, or http to localhost, 127.0.0.1 or [::1], and must not contain
# credentials; anything else is refused and nothing is sent. The key goes to whatever host
# you name. For a local http address also set no_proxy=127.0.0.1,localhost,[::1].
# NACE_BASE_URL=https://console.nace.ai/v1
